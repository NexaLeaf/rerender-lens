{
  "name": "rerender-lens",
  "version": "0.1.0",
  "description": "Find avoidable React re-renders and what caused them. Reads the fiber tree like React DevTools, so nothing is patched: works with Fast Refresh, memo, forwardRef and classes. Structured reports, test assertions, and a DevTools bridge.",
  "keywords": [
    "react",
    "rerender",
    "re-render",
    "performance",
    "why-did-you-render",
    "memo",
    "debug",
    "devtools"
  ],
  "license": "MIT",
  "author": "Palanisamy Muthusamy",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:pkg": "publint && attw --pack . --profile node16",
    "check": "npm run typecheck && npm test && npm run build && npm run lint:pkg",
    "prepublishOnly": "npm run check",
    "dev:example": "npm run build && npm --prefix examples/vite-react run dev"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^29.1.1",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexaLeaf/rerender-lens.git"
  },
  "homepage": "https://github.com/NexaLeaf/rerender-lens#readme",
  "bugs": {
    "url": "https://github.com/NexaLeaf/rerender-lens/issues"
  }
}
