{
  "name": "rerender-lens",
  "version": "0.2.0",
  "description": "Find avoidable React re-renders and what caused them. Reads the fiber tree like React DevTools, so nothing is patched: works with Fast Refresh, memo, forwardRef and classes. Structured reports, test assertions, and a DevTools bridge.",
  "keywords": [
    "react",
    "rerender",
    "re-render",
    "performance",
    "why-did-you-render",
    "memo",
    "debug",
    "devtools"
  ],
  "license": "MIT",
  "author": "Palanisamy Muthusamy",
  "type": "module",
  "sideEffects": [
    "./dist/setup.js",
    "./dist/setup.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/setup.d.ts",
        "default": "./dist/setup.js"
      },
      "require": {
        "types": "./dist/setup.d.cts",
        "default": "./dist/setup.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rerender-lens": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:pkg": "publint && attw --pack . --profile node16",
    "build:ext": "node scripts/build-extension.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "build:docs": "node scripts/build-docs.mjs",
    "docs:media": "node scripts/docs-media.mjs",
    "lint:ext": "npx --yes web-ext lint --source-dir dist-extension/firefox --warnings-as-errors=false",
    "version": "node scripts/sync-version.mjs && git add extension/manifest.json",
    "check": "npm run typecheck && npm test && npm run build && npm run lint:pkg && npm run build:ext",
    "prepublishOnly": "npm run check",
    "dev:example": "npm run build && npm --prefix examples/vite-react run dev"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^29.1.1",
    "marked": "^9.1.6",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexaLeaf/rerender-lens.git"
  },
  "homepage": "https://github.com/NexaLeaf/rerender-lens#readme",
  "bugs": {
    "url": "https://github.com/NexaLeaf/rerender-lens/issues"
  }
}
