{
  "name": "rerender-lens",
  "version": "0.5.0",
  "description": "Find avoidable React re-renders and what caused them. Reads the fiber tree like React DevTools, so nothing is patched: works with Fast Refresh, memo, forwardRef and classes. Structured reports, test assertions, and a DevTools bridge.",
  "keywords": [
    "react",
    "rerender",
    "re-render",
    "performance",
    "why-did-you-render",
    "memo",
    "debug",
    "devtools"
  ],
  "license": "MIT",
  "author": "Palanisamy Muthusamy",
  "type": "module",
  "sideEffects": [
    "./dist/setup.js",
    "./dist/setup.cjs",
    "./dist/vitest-setup.js",
    "./dist/vitest-setup.cjs",
    "./dist/jest-setup.js",
    "./dist/jest-setup.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./relay": {
      "import": {
        "types": "./dist/relay.d.ts",
        "default": "./dist/relay.js"
      },
      "require": {
        "types": "./dist/relay.d.cts",
        "default": "./dist/relay.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/playwright.d.ts",
        "default": "./dist/playwright.js"
      },
      "require": {
        "types": "./dist/playwright.d.cts",
        "default": "./dist/playwright.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      },
      "require": {
        "types": "./dist/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    },
    "./vitest/setup": {
      "import": {
        "types": "./dist/vitest-setup.d.ts",
        "default": "./dist/vitest-setup.js"
      },
      "require": {
        "types": "./dist/vitest-setup.d.cts",
        "default": "./dist/vitest-setup.cjs"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/jest.d.ts",
        "default": "./dist/jest.js"
      },
      "require": {
        "types": "./dist/jest.d.cts",
        "default": "./dist/jest.cjs"
      }
    },
    "./jest/setup": {
      "import": {
        "types": "./dist/jest-setup.d.ts",
        "default": "./dist/jest-setup.js"
      },
      "require": {
        "types": "./dist/jest-setup.d.cts",
        "default": "./dist/jest-setup.cjs"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/setup.d.ts",
        "default": "./dist/setup.js"
      },
      "require": {
        "types": "./dist/setup.d.cts",
        "default": "./dist/setup.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rerender-lens": "./dist/cli.js"
  },
  "files": [
    "dist",
    "panel",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-vendor.mjs && node scripts/copy-panel.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:pkg": "publint && attw --pack . --profile node16",
    "build:ext": "node scripts/build-extension.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "build:docs": "node scripts/build-docs.mjs",
    "docs:media": "node scripts/docs-media.mjs",
    "lint:ext": "npx --yes web-ext lint --source-dir dist-extension/firefox --warnings-as-errors=false",
    "version": "node scripts/sync-version.mjs && git add extension/manifest.json",
    "check": "npm run typecheck && npm test && npm run build && npm run test:built && npm run lint:pkg && npm run build:ext",
    "prepublishOnly": "npm run check",
    "dev:example": "npm run build && npm --prefix examples/vite-react run dev",
    "test:built": "vitest run test/vendor.test.ts",
    "e2e:next": "playwright test -c e2e/next.config.ts",
    "test:jest": "node scripts/jest-check.mjs",
    "test:react18": "npm install --prefix .react18 --no-save --no-package-lock --no-audit --no-fund react@18 react-dom@18 && vitest run --config test/react-compat.config.ts",
    "store:media": "node scripts/store-media.mjs",
    "test:react17": "npm install --prefix .react17 --no-save --no-package-lock --no-audit --no-fund react@17 react-dom@17 && REACT_COMPAT_DIR=.react17/node_modules vitest run --config test/react-compat.config.ts",
    "e2e:perf": "playwright test -c e2e/perf.config.ts"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "vitest": ">=1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@jest/globals": "^30.5.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "babel-jest": "^30.5.1",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jsdom": "^29.1.1",
    "marked": "^9.1.6",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexaLeaf/rerender-lens.git"
  },
  "homepage": "https://github.com/NexaLeaf/rerender-lens#readme",
  "bugs": {
    "url": "https://github.com/NexaLeaf/rerender-lens/issues"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
